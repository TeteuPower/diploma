{
  "name": "diploma",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Diploma — copiloto local que navega um LMS e resolve atividades sob a sua supervisão",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx server/index.ts\"",
    "server": "tsx server/index.ts",
    "web": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "navegador": "playwright install chromium",
    "teste": "tsx testes/cofre.ts && tsx testes/ferramentas.ts && tsx testes/atualizacao.ts && tsx testes/trabalhos.ts && tsx testes/navegador.ts",
    "teste:rapido": "tsx testes/cofre.ts && tsx testes/ferramentas.ts && tsx testes/atualizacao.ts && tsx testes/trabalhos.ts",
    "empacotar": "powershell -NoProfile -ExecutionPolicy Bypass -File build.ps1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.190",
    "express": "^4.21.2",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
